ENVIRONMENT=staging
PROCESSING_MODE=async
PROCESSING_WORKER_ENABLED=true
DATABASE_URL=postgresql+psycopg://staging-user:password@staging-neon-host/ai_legal_reviewer
JWT_SECRET_KEY=generate-a-new-staging-secret
CORS_ORIGINS=https://staging-lawyerlens.vercel.app
APP_BASE_URL=https://staging-lawyerlens.vercel.app
AI_PROVIDER=cloudflare_workers_ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5
CLOUDFLARE_OCR_MODEL=@cf/moondream/moondream3.1-9B-A2B
EMAIL_PROVIDER=brevo_api
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=AI Legal Reviewer Staging
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=false
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
SENTRY_DSN=
RELEASE_VERSION=staging
