# Production email uses Brevo HTTPS API (Render Free blocks SMTP ports).
EMAIL_PROVIDER=brevo_api
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=AI Legal Reviewer
APP_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=false

# Production database and browser access.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/ai_legal_reviewer
CORS_ORIGINS=https://ai-legal-document-reviewer.vercel.app
DB_POOL_SIZE=1
DB_MAX_OVERFLOW=0

# Cloudflare Workers AI. Use a model included in the Workers AI free allocation.
AI_PROVIDER=cloudflare_workers_ai
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
